  },
  "models": {
    "primary_pooled_asset_group": {
      "outcome": "equal_weight_forward_return",
      "formula": "z_outcome ~ z_feature + z_measurement_control + z_lagged_mom60 + z_lagged_volatility20 + asset_group_fixed_effects",
      "covariance": "record_id_cluster_robust_cr1",
      "minimum_event_clusters": 24
    },
    "secondary_asset_group": {
      "outcome": "equal_weight_forward_return",
      "formula": "z_outcome ~ z_feature + z_measurement_control + z_lagged_mom60 + z_lagged_volatility20",
      "covariance": "none_descriptive_coefficient_only",
      "minimum_events": 24
    },
    "secondary_dispersion": {
      "outcome": "cross_sectional_return_dispersion",
      "formula": "z_outcome ~ z_feature + z_measurement_control + z_mean_lagged_mom60 + z_mean_lagged_volatility20",
      "covariance": "newey_west_bartlett",
      "hac_lags_by_window": {"5": 0, "20": 0, "60": 1},
      "minimum_events": 24
