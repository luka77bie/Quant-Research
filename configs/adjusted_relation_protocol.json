    "report_every_timing_protocol": true,
    "report_every_forward_window": true,
    "report_excluded_models": true,
    "select_feature_from_results": false,
    "select_timing_from_results": false,
    "select_window_from_results": false,
    "portfolio_construction_allowed": false,
    "confirmatory_claim_allowed": false,
    "strict_point_in_time_claim_allowed": false
  },
  "interpretation_gate": {
